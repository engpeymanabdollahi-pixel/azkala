```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
vendor/
composer.lock
.env
.env.local
.env.*

# Build directories
dist/
build/
target/
public/build/

# Cache directories
.cache/
.php_cs.cache
.sass-cache/
.npm/
.yarn/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# PHP specific
.phpunit.result.cache
coverage/
.php_cs.cache

# Frontend build artifacts
frontend/dist/
frontend/build/
```