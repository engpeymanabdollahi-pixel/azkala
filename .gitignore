```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python artifacts (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Testing
.mypy_cache/
.pytest_cache/
.nyc_output/
coverage/

# Package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.obj
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```