APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# مبدأهایی که مرورگر اجازه دارد از آن‌ها به API درخواست بزند، جدا شده با کاما.
# روی production باید دامنه‌ی واقعی فرانت‌اند اینجا بیاید، وگرنه مرورگر هر پاسخ
# را بلاک می‌کند. خالی گذاشتنش یعنی همان پیش‌فرضِ محیط توسعه (پورت ۵۱۷۳ ویت).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# دامنه‌هایی که Sanctum درخواستشان را stateful می‌شمارد، یعنی با کوکی نشست
# احراز هویت می‌کند نه با توکن. باید همان مبدأهای بالا باشد، ولی بدون //:http.
# اگر دامنه‌ی فرانت‌اند اینجا نباشد، مرورگر کوکی می‌فرستد و Sanctum نادیده‌اش
# می‌گیرد — بی‌صدا به حالت توکن برمی‌گردد و نشست پس از refresh از بین می‌رود.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# روی production که فرانت‌اند و API زیر‌دامنه‌های یک دامنه‌اند، این را روی
# دامنه‌ی مادر بگذارید (مثلاً .azkala.ir) تا کوکی برای هر دو ارسال شود.
SESSION_DOMAIN=null

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# شماره تلفن کاربری که با «php artisan app:bootstrap-super-admin» به‌عنوان
# اولین Super Admin سیستم Multi-Admin/Permission تعیین می‌شود. آن کاربر
# باید از قبل (از مسیر واقعی ثبت‌نام/OTP سایت) در جدول users وجود داشته
# باشد؛ این متغیر کاربر جدید نمی‌سازد. روی production حتماً با شماره‌ی
# واقعی خودتان پر شود — این مقدار نمونه نیست و عمداً خالی گذاشته شده.
AZKALA_SUPER_ADMIN_PHONE=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Email Configuration for Production
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_username
# MAIL_PASSWORD=your_password
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_ENCRYPTION=tls

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ⚠️ برای مقیاس بالا (صدها هزار تا میلیون‌ها کاربر) این سه مقدار
# (SESSION_DRIVER، QUEUE_CONNECTION، CACHE_STORE) را روی production حتماً
# به redis تغییر دهید:
# - database یعنی هر خواندن/نوشتن نشست، هر job صف و هر خواندن/نوشتن OTP
#   کش، یک کوئری روی همان دیتابیسی می‌زند که سفارش/محصول/کاربر واقعی هم
#   رویش کار می‌کند — دقیقاً جایی که زیر بار زیاد اول از همه گیر می‌کند.
# - queue روی database یعنی هر job (مثل ارسال پیامک OTP — نگاه کنید به
#   App\Jobs\SendOtpSms) با SELECT...FOR UPDATE روی جدول jobs پردازش
#   می‌شود؛ برای هزاران ثبت‌نام هم‌زمان مقیاس‌پذیر نیست.
# پکیج predis/predis از قبل نصب است؛ کافی است این‌ها را عوض کنید:
#   SESSION_DRIVER=redis
#   QUEUE_CONNECTION=redis
#   CACHE_STORE=redis
#   REDIS_CLIENT=predis
# (یا اگر اکستنشن phpredis روی سرور نصب است، REDIS_CLIENT=phpredis سریع‌تر است)
# و worker صف را واقعاً اجرا کنید، وگرنه هیچ OTPیی هیچ‌وقت ارسال نمی‌شود:
#   php artisan queue:work redis --queue=sms,default
SESSION_DRIVER=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# پکیج predis/predis نصب است؛ برای استفاده بدون نیاز به اکستنشن PHP، این
# مقدار را predis بگذارید (اگر اکستنشن phpredis روی سرور دارید، آن سریع‌تر است).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Service Configuration
SMS_PROVIDER=log
KAVENEGAR_API_KEY=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=50005
GHASEDAK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
