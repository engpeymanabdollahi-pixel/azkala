# API Configuration
# ✅ برای dev محلی همین مقدار پیش‌فرض کافی است (vite.config.ts هم /api و
# /sanctum را به همین آدرس پروکسی می‌کند).
#
# ⚠️ برای production (build واقعی، `npm run build`) این مقدار باید صریحاً
# به آدرس HTTPS واقعی بک‌اند production تغییر کند — مثال:
#   VITE_API_URL=https://YOUR_PRODUCTION_API_DOMAIN
# اگر این متغیر در build production خالی بماند یا با https:// شروع نشود،
# اپ دیگر بی‌صدا به این آدرس محلی fallback نمی‌کند و در همان لحظه‌ی بالا
# آمدن با یک خطای صریح متوقف می‌شود (src/lib/apiConfig.ts).
VITE_API_URL=http://127.0.0.1:8000
VITE_APP_NAME="Azkala Marketplace"

# Free Shipping Threshold (به تومان)
VITE_FREE_SHIPPING_THRESHOLD=500000

# Optional: Third-party services (در صورت نیاز)
# VITE_SENTRY_DSN=
# VITE_ANALYTICS_ID=