import { useMutation, useQueryClient } from '@tanstack/react-query';
import toast from 'react-hot-toast';
import { wishlistService } from '@/services/api/wishlist.service'; // مسیر سرویس خود را تنظیم کنید

interface ToggleWishlistVariables {
  productId: number;
  isAdding: boolean;
}

export function useToggleWishlist() {
  const queryClient = useQueryClient();

  return useMutation({
    // ۱. تابع اصلی که درخواست به سرور را ارسال می‌کند
    mutationFn: async ({ productId, isAdding }: ToggleWishlistVariables) => {
      if (isAdding) {
        return await wishlistService.add(productId);
      } else {
        return await wishlistService.remove(productId);
      }
    },

    // ۲. این بخش "قبل" از ارسال درخواست به سرور اجرا می‌شود (قلب تپنده Optimistic UI)
    onMutate: async ({ productId, isAdding }) => {
      // الف) لغو هرگونه درخواست در حال اجرای مرتبط برای جلوگیری از تداخل داده‌ها
      await queryClient.cancelQueries({ queryKey: ['wishlist'] });

      // ب) گرفتن یک "عکس فوری" (Snapshot) از داده‌های فعلی کش برای استفاده در صورت خطا
      const previousWishlist = queryClient.getQueryData(['wishlist']);

      // ج) به‌روزرسانی فوری و خوش‌بینانه‌ی کش
      queryClient.setQueryData(['wishlist'], (old: any[] | undefined) => {
        if (!old) return old;
        
        if (isAdding) {
          // افزودن یک آیتم ساختگی (Mock) به لیست برای نمایش آنی
          return [...old, { id: productId, is_optimistic: true }];
        } else {
          // حذف فوری آیتم از لیست
          return old.filter((item: any) => item.id !== productId);
        }
      });

      // د) برگرداندن Snapshot به عنوان Context تا در صورت خطا در دسترس باشد
      return { previousWishlist };
    },

    // ۳. اگر سرور خطا برگرداند، این بخش اجرا می‌شود
    onError: (err, variables, context) => {
      // بازگرداندن داده‌ها به حالت قبل از تغییر (Rollback)
      queryClient.setQueryData(['wishlist'], context?.previousWishlist);
      
      // نمایش پیام خطا به کاربر
      toast.error('عملیات با خطا مواجه شد. تغییرات اعمال نشد.');
    },

    // ۴. چه درخواست موفق باشد چه ناموفق، این بخش همیشه اجرا می‌شود
    onSettled: () => {
      // اعتبارسنجی مجدد (Refetch) برای اطمینان از هماهنگی نهایی با سرور
      queryClient.invalidateQueries({ queryKey: ['wishlist'] });
    },
  });
}